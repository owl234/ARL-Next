# =========================
# ARL 生产环境敏感配置文件隔离
# =========================

# 忽略根目录的环境变量文件
.env

# 忽略后端实际生效的配置文件
# backend/config.yaml 为运行时实效配置（本地可含真实凭据），模板见 config.yaml.example
backend/config.yaml
backend/config-docker.yaml
backend/app/config.yaml


# Python cache files
__pycache__/
*.py[cod]

# Logs
*.log
backend/*.log

# IDE & OS files
.idea/
.DS_Store
.vscode/

# Test Cache
.pytest_cache/
.coverage
*graph.md
architecture_graphs/
reference/

# Celery Beat persistent db
backend/celerybeat-schedule.db
backend/.venv-docker/
**/.tmp_venv/

#系统临时生成文件
artifacts/
backend/app/tmp/
backend/app/tmp_screenshot/
data/
backend/data/
*.tar.gz
ssl-certs/
# 证书与私钥不入库：部署时由 start-prod.sh 生成，MCP 客户端按同机回环自动发现
certs/
.certs/
*.crt
*.key
*.pem
fingerprint_new/
.agents/
server.txt
lab/
apikey.txt
# GeoIP 数据库不入库（约 88MB）：部署时由 tools/fetch_geoip.py 按需获取并校验后装入命名卷 arl_geoip
# 版本声明 GEOIP_VERSIONS.json 保持入库；无 MAXMIND_LICENSE_KEY 时 GeoLite2 跳过，服务降级运行
backend/GeoLite2/*.mmdb
backend/GeoLite2/*.xdb
!backend/GeoLite2/GEOIP_VERSIONS.json
backend/ARL-NPoC/build/
backend/ARL-NPoC/xing.egg-info/
/tmp.txt
/logs/
dist/
frontend/dist/

# Nginx Basic Auth
frontend/.htpasswd

# MCP Server
mcp-server/.env
mcp-server/.venv/
Notify.txt

hot_update.sh
*.tar.gz

question.md

# Ruff cache
.ruff_cache/
ARL_auth.md
ARL_server.md

.claude/

AGENTS.md
CLAUDE.md
owl234.pem
# Node 依赖目录不入库：镜像构建已在 .dockerignore 排除，本地如需还原执行 npm ci
**/node_modules/

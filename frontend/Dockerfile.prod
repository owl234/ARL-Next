# 阶段一：构建 Vue3 代码
FROM node:20-alpine AS builder
WORKDIR /app

# 避免 corepack 下载使用 node:sqlite 的 pnpm v10 导致 Node 20 不兼容报错
RUN npm install -g pnpm@9

# 利用 Docker 缓存层安装依赖
COPY package.json pnpm-lock.yaml ./
RUN pnpm install --frozen-lockfile

# 复制源码并打包
COPY . .
RUN pnpm run build

# 官方 Debian 镜像使用 Trixie。仅复用签名密钥和容器入口脚本。
FROM nginx:1.30.7-trixie@sha256:7fad6c0dff97965adbddf28027d934b111fc0221a554315dc274712f3fba24d3 AS nginx-upstream

# 阶段二：使用官方 Bookworm 软件包，保留旧内核所需的 glibc 运行环境。
FROM debian:bookworm-slim@sha256:734a72b3d6142a71993b4bc580ca01d8ca687f77a2c422d96a961d3376b179bc
ENV NGINX_VERSION=1.30.7
COPY --from=nginx-upstream /etc/apt/keyrings/nginx-archive-keyring.gpg /etc/apt/keyrings/
RUN groupadd --system --gid 101 nginx \
    && useradd --system --uid 101 --gid nginx --no-create-home --home /nonexistent --shell /bin/false nginx \
    && apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates \
    && echo 'deb [signed-by=/etc/apt/keyrings/nginx-archive-keyring.gpg] https://nginx.org/packages/debian bookworm nginx' > /etc/apt/sources.list.d/nginx.list \
    && apt-get update \
    && apt-get install -y --no-install-recommends \
        "nginx=${NGINX_VERSION}-1~bookworm" \
        "nginx-module-geoip=${NGINX_VERSION}-1~bookworm" \
        "nginx-module-image-filter=${NGINX_VERSION}-1~bookworm" \
        "nginx-module-njs=${NGINX_VERSION}+1.0.2-1~bookworm" \
        "nginx-module-xslt=${NGINX_VERSION}-1~bookworm" \
        curl gettext-base \
    && rm -rf /var/lib/apt/lists/* /etc/apt/sources.list.d/nginx.list \
    && ln -sf /dev/stdout /var/log/nginx/access.log \
    && ln -sf /dev/stderr /var/log/nginx/error.log

COPY --from=nginx-upstream /docker-entrypoint.sh /
COPY --from=nginx-upstream /docker-entrypoint.d/ /docker-entrypoint.d/
# 将构建好的 dist 文件复制到 Nginx 默认目录
COPY --from=builder /app/dist /usr/share/nginx/html

# 暴露 Nginx 端口
EXPOSE 80 5173

# 将生产环境反向代理与 HTTPS 配置塞进容器
COPY default.conf.prod /etc/nginx/conf.d/default.conf

# 运行 Nginx
ENTRYPOINT ["/docker-entrypoint.sh"]
STOPSIGNAL SIGQUIT
CMD ["nginx", "-g", "daemon off;"]
